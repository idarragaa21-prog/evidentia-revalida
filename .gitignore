*.keystore
*.jks

# Chaves de licenca: a privada NUNCA entra no repositorio.
nuvem/chaves/
!nuvem/chaves/.gitkeep
nuvem/supabase/client_config.local.json
aplicativo/Revalida_Evidentia_teste.html

# A edicao completa e o produto pago: nao entra em repositorio, nem sequer privado.
# Publica-la aqui entregaria de graca o que se vende, e o portao de licenca do lado
# do aparelho e uma barreira de honestidade, nao um cofre — quem tem o arquivo tem
# o conteudo. O que se distribui e o instalador assinado, depois da compra.
aplicativo/Revalida_Evidentia.html
aplicativo/Revalida_Evidentia_ios.html
aplicativo/Revalida_Evidentia_android.html
app-android/www/index.html
app-android/android/app/src/main/assets/public/index.html
app-android/*.apk

# Fontes editoriais e dados premium. Permanecem nas maquinas autorizadas para
# gerar os instaladores, mas nao entram no repositorio publico. Somente os dois
# ativos de marca abaixo podem ser rastreados em dados/; a amostra livre e
# gerada em HTML e continua versionada separadamente.
dados/**
!dados/favicon_b64.txt
!dados/logo_b64.txt
scripts/justificativas_*/
scripts/tabelas_*.py
scripts/verificar_gabaritos.py

# Estado local del CLI de Supabase (enlace del proyecto): no se versiona
nuvem/supabase/.temp/
supabase/.temp/

# iOS: dependencias y contenido gerado (o app completa nao entra no repo)
app-android/ios/App/Pods/
app-android/ios/App/App/public/
app-android/ios/App/Podfile.lock
